# ==============================================================================
# HanuJai High School ERP — WhatsApp Worker Configuration
# Campus: HanuJai High School, Jaipur, Rajasthan, India
# ==============================================================================

# Messaging Provider: 'baileys' (Phase 1 Pilot) or 'dry_run' or 'cloud_api'
WHATSAPP_PROVIDER=baileys

# Master Live Send Switch: Set to 'true' only when ready to dispatch real WhatsApp messages
# Keep 'false' for dry-run simulation mode (logs previews without external socket calls)
WHATSAPP_SEND_ENABLED=false

# Dry Run Mode: 'true' simulates send operations and prevents any actual WhatsApp transmission
WHATSAPP_DRY_RUN=true

# Persistent WhatsApp Web Session Directory (Excluded from Git via .gitignore)
WHATSAPP_AUTH_DIR=./.baileys_auth

# Test Recipient Phone Number Allowlist (Comma-separated 10-digit or 12-digit numbers)
# When set, ONLY numbers in this list will receive real messages.
# All demo cohort numbers (+91 98291 XXXXX) will be safely skipped.
# Example: WHATSAPP_TEST_ALLOWLIST=919829012345,9829054321
WHATSAPP_TEST_ALLOWLIST=

# Worker Local Health Check & Status Server Port
WHATSAPP_WORKER_PORT=5050

# Firebase Web App Configuration (Identical to main ERP project in .env.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Path to Firebase Admin SDK Service Account JSON (For production persistent servers)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
