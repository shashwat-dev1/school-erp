# ==============================================================================
# HanuJai High School ERP — Environment Configuration Template
# Campus: HanuJai High School, Jaipur, Rajasthan, India
#
# INSTRUCTIONS:
# - Copy this file to '.env.local' for local development.
# - Never commit '.env.local' to source control.
# - In 'demo' mode, the application functions offline with deterministic sample data.
# - In 'firebase' mode, valid project credentials below are strictly required.
# ==============================================================================

# Data Mode: 'demo' or 'firebase'
VITE_DATA_MODE=demo

# Firebase Web Application Configuration (Required only when VITE_DATA_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
