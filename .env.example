# ==============================================================================
# HanuJai High School ERP — Environment Configuration Template
# Campus: HanuJai High School, Jaipur, Rajasthan, India
#
# INSTRUCTIONS:
# - Copy this file to '.env.local' for local development.
# - Never commit '.env.local' to source control.
# - In 'demo' mode, the application functions offline with deterministic sample data.
# - In 'firebase' mode, valid project credentials below are strictly required.
# ==============================================================================

# Data Mode: 'demo' or 'firebase'
VITE_DATA_MODE=firebase

# Firebase Web Application Configuration (Required when VITE_DATA_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# WhatsApp Notification Service Configuration (Phase 1)
# ==============================================================================

# Provider: 'baileys' (Phase 1 Pilot worker) | 'dry_run' (simulation) | 'cloud_api' (official)
VITE_WHATSAPP_PROVIDER=baileys
WHATSAPP_PROVIDER=baileys

# Master Live Send Switch: Set to 'true' to allow real WhatsApp socket transmission.
# When 'false', all messages are logged in dry-run mode or skipped safely.
VITE_WHATSAPP_SEND_ENABLED=false
WHATSAPP_SEND_ENABLED=false

# Dry-run flag: 'true' simulates message dispatch without calling WhatsApp network
WHATSAPP_DRY_RUN=true

# Persistent WhatsApp Web Session Directory (Excluded from Git via .gitignore)
WHATSAPP_AUTH_DIR=./.baileys_auth

# Test Recipient Phone Number Allowlist (Comma-separated pure digits with country code)
# Example: 919829012345,919800000001
# CRITICAL SAFETY: Only numbers in this list can receive real WhatsApp messages during testing.
# All demo cohort numbers (+91 98291 XXXXX) will be safely skipped.
VITE_WHATSAPP_TEST_ALLOWLIST=
WHATSAPP_TEST_ALLOWLIST=

# Worker Local Health Check & Status Server Port
WHATSAPP_WORKER_PORT=5050
