{
  "name": "hanujai-erp",
  "private": true,
  "version": "1.0.0",
  "description": "Custom internal School ERP for HanuJai High School, Jaipur, Rajasthan, India",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:firebase": "npx --yes tsx scripts/seedFirebase.ts",
    "whatsapp:worker": "node --experimental-strip-types scripts/whatsappWorker.ts",
    "whatsapp:status": "node --experimental-strip-types scripts/whatsappStatus.ts",
    "whatsapp:logout": "node --experimental-strip-types scripts/whatsappLogout.ts",
    "whatsapp:test": "node --experimental-strip-types scripts/whatsappSendTest.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "firebase": "^11.0.2",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
