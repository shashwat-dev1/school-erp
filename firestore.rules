rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isPrincipal() {
      return hasRole('principal');
    }

    function isAssignedClassTeacher(classId) {
      return isAuthenticated() && (
        getUserData().role == 'class_teacher' && 
        getUserData().assignedClassId == classId
      );
    }

    function isAssignedSubjectTeacher(classId, subjectId) {
      return isAuthenticated() && (
        getUserData().role == 'subject_teacher' &&
        subjectId in getUserData().assignedSubjects &&
        classId in getUserData().assignedClasses
      );
    }

    // Default: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // School Settings: Read by authenticated staff; Principal is strictly read-only in pilot
    match /schoolSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Academic Years: Read by authenticated staff; write disabled in pilot
    match /academicYears/{yearId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Classes & Sections: Read by authenticated staff; write disabled in pilot
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Subjects: Read by authenticated staff; write disabled in pilot
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Subject Assignments: Read by authenticated staff; write disabled in pilot
    match /subjectAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Staff Accounts: Read by authenticated staff; allow authenticated user to link their own document
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == staffId;
      allow delete: if false;
    }

    // Student Master Records: Read authorized by assigned class/section or principal oversight.
    // Writes are disabled in this pilot phase (managed via trusted server or read-only).
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        isAssignedClassTeacher(resource.data.classId) ||
        (getUserData().role == 'subject_teacher' && resource.data.classId in getUserData().assignedClasses)
      );
      allow create, update, delete: if false;
    }

    // Attendance Sessions & Daily Registers:
    // Only assigned Class Teacher can submit attendance for their section. Principal has read-only oversight.
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isPrincipal() || 
        isAssignedClassTeacher(resource.data.classId)
      );
      
      allow create, update: if isAuthenticated() && isAssignedClassTeacher(request.resource.data.classId);
      allow delete: if false;
    }

    // Aggregate-only attendance for subject teachers. This collection contains no student names or records.
    match /attendanceAggregates/{aggregateId} {
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        isAssignedClassTeacher(resource.data.classId) ||
        (getUserData().role == 'subject_teacher' && resource.data.classId in getUserData().assignedClasses)
      );
      allow create, update: if isAuthenticated() && isAssignedClassTeacher(request.resource.data.classId);
      allow delete: if false;
    }

    // Attendance Correction Requests:
    // Only assigned Class Teacher can request corrections for their section.
    match /attendanceCorrections/{correctionId} {
      allow read: if isAuthenticated() && (
        isPrincipal() || 
        resource.data.requestedByStaffId == request.auth.uid ||
        isAssignedClassTeacher(resource.data.classId)
      );
      
      allow create: if isAuthenticated() && 
        isAssignedClassTeacher(request.resource.data.classId) && 
        request.resource.data.requestedByStaffId == request.auth.uid;

      allow update, delete: if false;
    }

    // Assessment Definitions:
    // Read by authenticated staff; write disabled in pilot
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Marks Registers:
    // Principal can read all registers; Class Teacher can read assigned class; Subject Teacher can read their assigned subject.
    // Writes strictly restricted to assigned Subject Teacher.
    match /marksRegisters/{registerId} {
      allow read: if isAuthenticated() && (
        isPrincipal() || 
        isAssignedClassTeacher(resource.data.classId) ||
        isAssignedSubjectTeacher(resource.data.classId, resource.data.subjectId)
      );

      allow create, update: if isAuthenticated() && (
        isAssignedSubjectTeacher(request.resource.data.classId, request.resource.data.subjectId) &&
        (resource == null || resource.data.status != 'submitted') &&
        request.resource.data.maxMarks != null &&
        request.resource.data.maxMarks > 0
      );

      allow delete: if false;
    }

    // Teacher Notes:
    // Only assigned Class Teacher can record notes for students in their assigned section (safest baseline).
    // Principal has read-only oversight.
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        isPrincipal() || 
        isAssignedClassTeacher(resource.data.classId) ||
        (getUserData().role == 'subject_teacher' && resource.data.classId in getUserData().assignedClasses)
      );
      allow create: if isAuthenticated() && isAssignedClassTeacher(request.resource.data.classId);
      allow update, delete: if false;
    }

    // System Audit Log: Append-only, prevents forgery of actor identity
    match /auditEvents/{eventId} {
      allow read: if isPrincipal();
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Student Follow-up & Pastoral Care Notes
    match /studentFollowUps/{followUpId} {
      allow read: if isAuthenticated() && (
        isPrincipal() ||
        getUserData().role == 'class_teacher' ||
        getUserData().role == 'subject_teacher'
      );
      allow create: if isAuthenticated() && 
        !isPrincipal() && 
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
