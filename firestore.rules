rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role && getUserData().status == 'active';
    }

    function isPrincipal() {
      return hasRole('principal');
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('developer');
    }

    // Default: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // School Settings: Read by authenticated staff; Principal is strictly read-only
    match /schoolSettings/{settingId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow write: if false;
    }

    // Academic Years: Read by authenticated staff
    match /academicYears/{yearId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow write: if false;
    }

    // Classes & Sections: Read by authenticated staff
    match /classes/{classId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow write: if false;
    }

    // Staff Accounts: Read by authenticated staff; allow authenticated user to link their own document
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == staffId;
      allow delete: if false;
    }

    // Student Master Records: Read authorized for Principal oversight and Admin Office operations.
    match /students/{studentId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // Attendance Sessions & Daily Registers:
    // Admin Office submits registers for any authorized school class. Principal has strictly read-only oversight.
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // Attendance WhatsApp Notifications:
    // Admin Office generates parent notification jobs upon submission. Principal has read oversight.
    match /attendanceNotifications/{jobId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // Aggregate-only attendance metrics.
    match /attendanceAggregates/{aggregateId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // Attendance Correction Records:
    // Admin Office can record corrections. Principal has read-only audit oversight.
    match /attendanceCorrections/{correctionId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // System Audit Log: Append-only, prevents forgery of actor identity
    match /auditEvents/{eventId} {
      allow read: if isAuthenticated() && (isPrincipal() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
